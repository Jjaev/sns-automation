{
  "name": "sns-automation",
  "version": "1.0.0",
  "description": "Notion → SNS 자동 업로드 파이프라인 (무료 운영)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dry-run": "DRY_RUN=true node src/index.js",
    "test-notion": "node src/notion.js --test",
    "test-instagram": "node src/instagram.js --test",
    "sync-cms": "node src/sync-cms.js",
    "bulk-gen": "node src/bulk-generate.mjs --count=20",
    "research": "node scripts/research-barriers.mjs",
    "assistant": "node scripts/ai-assistant.mjs",
    "assistant:morning": "node scripts/ai-assistant.mjs --mode=morning",
    "assistant:evening": "node scripts/ai-assistant.mjs --mode=evening",
    "assistant:weekly": "node scripts/ai-assistant.mjs --mode=weekly"
  },
  "type": "module",
  "dependencies": {
    "@notionhq/client": "^5.21.0",
    "dotenv": "^17.4.2",
    "node-fetch": "^3.3.2"
  }
}
