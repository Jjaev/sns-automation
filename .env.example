# =============================================
# SNS Automation - 환경 변수 설정
# =============================================

# --- Notion (필수) ---
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Instagram Graph API (필수 - Facebook Dev 설정 필요) ---
# Facebook 앱 만들기: https://developers.facebook.com/apps/
# Instagram Business/Creator 계정 연결 필요
INSTAGRAM_ACCESS_TOKEN=EAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_BUSINESS_ID=xxxxxxxxxxxxxxxxxxxx  # Instagram Business Account ID

# --- DeepSeek API (선택 - 캡션 자동 생성용) ---
# 가입: https://platform.deepseek.com/ (무료 크레딧 $5)
# DeepSeek 없어도 동작함. Notion Caption 필드에 직접 입력하면 됨
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 실행 설정 ---
# CRON 표현식: 분 시 일 월 요일
# 기본: 매일 09:00, 12:00, 18:00 (하루 3회)
CRON_SCHEDULE="0 9,12,18 * * *"

# DRY_RUN=true면 실제 업로드 안 함 (테스트용)
DRY_RUN=false
